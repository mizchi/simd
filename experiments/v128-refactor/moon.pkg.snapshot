import {
  "moonbitlang/core/bench",
  "moonbitlang/core/float",
  "mizchi/simd/src/internal",
}

options(
  "native-stub": [ "simd_native.c" ],
  targets: {
    "simd_scalar.mbt": [ "js", "wasm-gc" ],
    "simd_native.mbt": [ "native" ],
    "simd_native_ffi.mbt": [ "native" ],
    "simd_wasm_i32.mbt": [ "wasm" ],
    "simd_wasm_v128.mbt": [ "wasm" ],
    "simd_wasm_f64.mbt": [ "wasm" ],
    "simd_wasm_f32.mbt": [ "wasm" ],
    "simd_wasm_bytes.mbt": [ "wasm" ],
    "simd_wasm_sort.mbt": [ "wasm" ],
  },
)
