    "simd_buffer_scalar_f64.mbt": [ "native", "js" ],
    "simd_buffer_scalar_f32.mbt": [ "native", "js" ],
    "simd_buffer_scalar_bytes.mbt": [ "native", "js" ],
    "simd_buffer_scalar_ring.mbt": [ "native", "js" ],
